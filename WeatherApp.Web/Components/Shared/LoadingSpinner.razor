<div class="loading-spinner" data-test="loading-spinner">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Загрузка...</span>
    </div>
    <p>@Message</p>
</div>

@code {
    [Parameter] public string Message { get; set; } = "Загрузка данных...";
}