@inherits LayoutComponentBase

<div class="app-layout @(_sidebarOpen ? "sidebar-open" : "")">

    <aside class="sidebar" role="navigation">
        <NavMenu IsOpen="@_sidebarOpen" OnClose="@CloseSidebar" />
    </aside>

    <div class="sidebar-backdrop" @onclick="CloseSidebar"></div>

    <main class="app-main" role="main">
        <header class="app-header">
            <button class="hamburger" @onclick="ToggleSidebar" aria-label="Меню" aria-expanded="@_sidebarOpen">
                <span></span><span></span><span></span>
            </button>
            <div class="header-title">Sun&Rain</div>
        </header>

        <article class="app-content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _sidebarOpen;

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
    private void CloseSidebar() => _sidebarOpen = false;
}
