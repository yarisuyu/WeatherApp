<nav class="nav-menu @(IsOpen ? "open" : "")" role="navigation" aria-hidden="false">
    <div class="nav-header">
        <span class="nav-brand">Sun&Rain</span>
        <button class="nav-close" @onclick="Close" aria-label="Закрыть">✕</button>
    </div>

    <div class="nav-items">
        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All" @onclick="Close">
            <span class="bi bi-house-door-fill"></span> Текущая погода
        </NavLink>
    </div>
</nav>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Task Close()
    {
        return OnClose.HasDelegate ? OnClose.InvokeAsync(null) : Task.CompletedTask;
    }
}
