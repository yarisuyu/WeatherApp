<div class="metric-card" data-test="metric-card">
    <div class="metric-title">@Title</div>
    <div class="metric-values">
        @foreach (var item in Items)
        {
            <div class="metric-value">
                <span class="value">@item.Value</span>
                <span class="label">@item.Label</span>
            </div>
        }
    </div>
    @if (ShowDetailsLink)
    {
        <button class="metric-details-btn" @onclick="OnDetails">Подробный прогноз ›</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public List<(string Value, string Label)> Items { get; set; } = new();
    [Parameter] public bool ShowDetailsLink { get; set; }
    [Parameter] public EventCallback OnDetails { get; set; }
}